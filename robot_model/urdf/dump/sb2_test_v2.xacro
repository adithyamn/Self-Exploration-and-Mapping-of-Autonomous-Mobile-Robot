<?xml version='1.0'?>

<robot name="robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find robot_model)/urdf/sb2_test_v2.gazebo" />
  
  <!-- Dummy Base Footprint-->
  <link name="base_footprint"></link>

  <!-- Chassis Link - Base -->
  <link name='base_link'>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0.0 0 0.55" rpy="0 0 0"/>
      <inertia
          ixx="0.1" ixy="0" ixz="0"
          iyy="0.1" iyz="0"
          izz="0.1" />
    </inertial>

    <collision name='collision'>
     <origin xyz="0 0 0.55" rpy=" 0 0 0"/>
      <geometry>
        <box size=".4806 .97 .85"/>
      </geometry>
    </collision>

    <visual name='chassis_visual'>
      <origin xyz="0 0 0.55" rpy=" 0 0 0"/>
      <geometry>
        <box size=".4806 .97 .85"/>
        <!--mesh filename="package://robot_model/meshes/ASMB_SB2_Shell v2.stl">
          <scale>0.001 0.001 0.001</scale>
        </mesh-->
      </geometry>
    </visual>

    <collision name='caster_collision'>
      <origin xyz="0 -0.25 0.125" rpy=" 0 0 0"/>
      <geometry>
        <sphere radius="0.125"/>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>0</mu>
            <mu2>0</mu2>
            <slip1>1.0</slip1>
            <slip2>1.0</slip2>
          </ode>
        </friction>
      </surface>
    </collision>

    <visual name='caster_visual'>
      <origin xyz="0 -0.25 0.125" rpy=" 0 0 0"/>
      <geometry>
        <sphere radius="0.125"/>
      </geometry>
    </visual>

  </link>

  <!-- Left Wheel Link-->
  <link name="left_wheel">
    <collision name="lw_collision">
      <origin xyz="-0 -0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.125" length="0.05"/>
      </geometry>
    </collision>
    <visual name="left_wheel_visual">
      <origin xyz="-0 -0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.125" length="0.05"/>
      </geometry>
    </visual>
    <inertial>
      <origin xyz="-0 -0 0" rpy="0 0 0"/>
      <mass value="1"/>
      <inertia
        ixx=".1" ixy="0.0" ixz="0.0"
        iyy=".1" iyz="0.0"
        izz=".1"/>
    </inertial>
  </link>

  <!-- Right wheel Link-->
  <link name="right_wheel">
  
    <collision name="rw_collision">
      <origin xyz="-0 -0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.125" length="0.05"/>
      </geometry>
    </collision>
    <visual name="right_wheel_visual">
     <origin xyz="-0 -0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.125" length="0.05"/>
      </geometry>
    </visual>
    <inertial>
      <origin xyz="-0 -0 0" rpy="0 0 0"/>
      <mass value="1"/>
      <inertia
        ixx=".1" ixy="0.0" ixz="0.0"
        iyy=".1" iyz="0.0"
        izz=".1"/>
    </inertial>
  </link>
  
  <!-- Hokuyo Laser Scanner Link -->
  <link name="hokuyo">

    <collision>
      <origin xyz="-0 -0 0" rpy="0 0 0"/>
      <geometry>
    <box size="0.1 0.1 0.1"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="-0 -0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_model/meshes/hokuyo.dae"/>
      </geometry>
    </visual>

    <inertial>
      <mass value="1e-5" />
      <origin xyz="-0 -0 0" rpy="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
    </inertial>

  </link>

  <!-- Base to footprint Joint-->
  <joint name="base_to_footprint_joint" type="fixed">
     <child link="base_link"/>
     <parent link="base_footprint"/>
  </joint>
  
  <!-- Left Wheel Joint-->
  <joint type="continuous" name="left_wheel_hinge">
   <origin xyz="0.2403 0.275 0.125" rpy="-1.5707 -0 1.5707"/>
    <child link="left_wheel"/>
    <parent link="base_link"/>
    <axis xyz="0 0 1" rpy="0 0 0"/>
    <limit effort="10000" velocity="1000"/>
    <joint_properties damping="1.0" friction="1.0"/>
  </joint>

  <!-- Right Wheel Joint-->
  <joint type="continuous" name="right_wheel_hinge">
     <origin xyz="-0.2403 0.275 0.125" rpy="1.5707 -0 -1.5707"/>
    <child link="right_wheel"/>
    <parent link="base_link"/>
    <axis xyz="0 0 1" rpy="0 0 0"/>
    <limit effort="10000" velocity="1000"/>
    <joint_properties damping="1.0" friction="1.0"/>
  </joint>

  <!-- Hokuyo Laser Joint -->
  <joint name="hokuyo_joint" type="fixed">
    <axis xyz="0 0 1"  rpy="0 0 0"/>
    <origin xyz="0 -0.5 0.250" rpy="0 3.14 1.57"/>
    <parent link="base_link"/>
    <child link="hokuyo"/>
  </joint>

</robot>